# Sort articles inside a feed by date, newest first
# Options: date-desc, date-asc, title-asc, title-desc
article-sort-order date-asc

# Sort the main feed menu by the date of its newest article This ensures active
# feeds immediately jump to the top of your screen
feed-sort-order lastupdated-desc

# Automatically refresh all feeds every time you open Newsboat
auto-reload no

# Hide feeds that have 0 unread articles (keeps your view clutter-free)
# Press "Ctrl+T" in Newsboat to temporarily toggle hidden feeds back into view
show-read-feeds no

# Change the default browser to open links (replace with your browser of choice)
# Pressing "o" on an article will launch it here
browser "xdg-open %u"
